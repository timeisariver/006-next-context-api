{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh auth status)",
      "Bash(git fetch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Edit(/app/api/**)",
      "Write(/app/api/**)",
      "Edit(/.claude/worktrees/*/app/api/**)",
      "Write(/.claude/worktrees/*/app/api/**)"
    ]
  }
}
